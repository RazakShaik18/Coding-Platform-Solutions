#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        string S;
        cin >> S;

        int x = 0;
        int y = 0;

        for (int i = 0; i < N; i++) {
            if (S[i] == 'U')
                y++;
            else if (S[i] == 'D')
                y--;
            else if (S[i] == 'L')
                x--;
            else if (S[i] == 'R')
                x++;
        }

        bool possible = false;

        if (x == 2 && S.find('R') != string::npos)
            possible = true;

        if (x == -2 && S.find('L') != string::npos)
            possible = true;

        if (y == 2 && S.find('U') != string::npos)
            possible = true;

        if (y == -2 && S.find('D') != string::npos)
            possible = true;

        if (possible)
            cout << "YES" << endl;
        else
            cout << "NO" << endl;
    }

    return 0;
}
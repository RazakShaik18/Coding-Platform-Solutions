#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        string s;
        cin >> s;

        int x = 0;
        int y = 0;

        for (int i = 0; i < n; i++) {
            if (s[i] == 'U')
                y++;
            else if (s[i] == 'D')
                y--;
            else if (s[i] == 'L')
                x--;
            else
                x++;
        }

        bool pos = false;

        if (x == 2 && s.find('R') != string::npos)
            pos = true;

        if (x == -2 && s.find('L') != string::npos)
            pos = true;

        if (y == 2 && s.find('U') != string::npos)
            pos = true;

        if (y == -2 && s.find('D') != string::npos)
            pos = true;

        if (pos)
            cout << "YES" << endl;
        else
            cout << "NO" << endl;
    }

    return 0;
}